{
  "manifest_version": 3,
  "name": "Article to Word Extractor",
  "version": "2.1",
  "description": "استخراج محتوای متنی، هدینگ‌ها و جدول‌های مقاله و دانلود به صورت فایل Word",
  "author": "Majid Vosoughy",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "استخراج مقاله به Word",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
